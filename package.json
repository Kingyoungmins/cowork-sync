{
  "name": "cowork-sync",
  "version": "0.1.0-preview",
  "private": true,
  "description": "Real-time code sync between Claude Code sessions on different PCs, over a shared git remote.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "node tools/build/build.mjs",
    "build:plugin": "node tools/release/stage-plugin.mjs",
    "viz:golden": "tsx tools/viz/golden.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tools/test/run-tests.mjs test/unit test/integration",
    "test:unit": "node tools/test/run-tests.mjs test/unit",
    "test:integration": "node tools/test/run-tests.mjs test/integration",
    "lint": "tsx tools/lint/lint.ts",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test && npm run sim:smoke && npm run sim:seeds -- --profile edits --seeds 5",
    "sim:smoke": "tsx tools/sim/smoke.ts",
    "sim:seeds": "tsx tools/sim/run-seeds.ts",
    "sim:exit": "tsx tools/sim/run-seeds.ts --profile edits --seeds 1000 --parallel 8",
    "real:two-clone": "tsx tools/real/two-clone.ts",
    "real:cleanup": "tsx tools/real/cleanup.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "esbuild": "^0.24.2",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
