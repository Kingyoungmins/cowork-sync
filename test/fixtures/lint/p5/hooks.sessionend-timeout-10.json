{
  "hooks": {
    "SessionStart": [
      {"matcher":"startup|resume|clear|compact|fork","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","SessionStart"],"timeout":10}]}
    ],
    "UserPromptSubmit": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","UserPromptSubmit"],"timeout":10}]}
    ],
    "UserPromptExpansion": [
      {"matcher":"cowork|cowork-sync:cowork","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","UserPromptExpansion"],"timeout":10}]}
    ],
    "PreToolUse": [
      {"matcher":"^(Edit|Write|MultiEdit|NotebookEdit)$","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PreToolUse"],"timeout":10}]},
      {"matcher":"^(Bash|PowerShell|Monitor)$","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PreToolUse"],"timeout":10}]},
      {"matcher":"^(Agent|EnterWorktree)$","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PreToolUse"],"timeout":10}]}
    ],
    "PostToolUse": [
      {"matcher":".*","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PostToolUse"],"timeout":10}]}
    ],
    "PostToolUseFailure": [
      {"matcher":".*","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PostToolUseFailure"],"timeout":10}]}
    ],
    "PostToolBatch": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PostToolBatch"],"timeout":10}]}
    ],
    "Stop": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","Stop"],"timeout":10}]}
    ],
    "StopFailure": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","StopFailure"],"timeout":10}]}
    ],
    "SubagentStart": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","SubagentStart"],"timeout":10}]}
    ],
    "SubagentStop": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","SubagentStop"],"timeout":10}]}
    ],
    "SessionEnd": [
      {"hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","SessionEnd"],"timeout":10}]}
    ],
    "PermissionDenied": [
      {"matcher":".*","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","PermissionDenied"],"timeout":10}]}
    ],
    "Notification": [
      {"matcher":"idle_prompt|permission_prompt","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/dist/hook.js","Notification"],"timeout":10}]}
    ]
  }
}
